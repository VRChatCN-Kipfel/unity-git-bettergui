# Normalize line endings — all text files stored and checked out as LF.

* text=auto eol=lf

# Unity asset metadata (YAML text)

*.meta text eol=lf

# Explicit binary (safety net): native libs, archives, images

*.dll binary
*.so binary
*.bundle binary
*.jar binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.zip binary
*.unitypackage binary